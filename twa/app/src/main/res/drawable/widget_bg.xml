<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vidrio: tinte oscuro translúcido, borde luminoso y esquinas redondeadas. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#22FFFFFF"
                android:centerColor="#1A2A2A2A"
                android:endColor="#44000000" />
            <stroke
                android:width="1.5dp"
                android:color="#77FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Destello superior del cristal (reflejo especular). -->
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="1dp"
        android:bottom="42dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</layer-list>
